{
  "name": "one-piece-zero-spoiler",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosimochellini/one-piece-zero-spoiler.git"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gate:react-doctor": "node scripts/react-doctor-gate.mjs",
    "gate:fallow": "node scripts/fallow-gate.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run gate:react-doctor && npm run gate:fallow"
  },
  "reactDoctor": {
    "supplyChain": {
      "enabled": false
    }
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fallow": "3.24.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react-doctor": "0.9.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "unplugin": "3.3.0"
  }
}
