# Read by Cloudflare's static assets. It does not apply these rules to a
# server-rendered page; the security headers are set
# in src/security-headers.ts.

# Vite content-hashes every client asset, so they are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The font files are not content-hashed, so a change to one of them is shipped
# under a new filename (bump the name in src/styles/global.css and the preload
# in src/routes/__root.tsx). That is what lets them be cached forever too.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
